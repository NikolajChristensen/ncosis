[Unit]
Description=ncosis stem separation server
After=network-online.target
Wants=network-online.target

[Service]
User=ncosis
Group=ncosis
WorkingDirectory=/opt/ncosis/backend
Environment=NCOSIS_DATA_DIR=/var/lib/ncosis
Environment=NCOSIS_WEB_DIST=/opt/ncosis/web/dist
# Music folder passed in from the Proxmox host (read-only); "Add from library" appears once it exists.
Environment=NCOSIS_LIBRARY_DIR=/mnt/music
# Optional overrides, e.g. NCOSIS_MVSEP_TOKEN=... (root-owned, mode 600).
EnvironmentFile=-/etc/ncosis.env
ExecStart=/opt/ncosis/backend/.venv/bin/uvicorn ncosis.main:app --host 0.0.0.0 --port 443 \
    --ssl-keyfile /var/lib/ncosis/tls/server.key --ssl-certfile /var/lib/ncosis/tls/server.crt
# Allow binding port 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure

[Install]
WantedBy=multi-user.target
